---
import { siteConfig } from "../config/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner container">
    <p class="site-footer__copy">© {year} {siteConfig.name}. All rights reserved.</p>
    <ul class="site-footer__links">
      <li><a href={`mailto:${siteConfig.contact.email}`}>Email</a></li>
      <li>
        <a href={siteConfig.contact.whatsapp} target="_blank" rel="noopener noreferrer">
          WhatsApp
        </a>
      </li>
      <li>
        <a href={siteConfig.contact.linkedin} target="_blank" rel="noopener noreferrer">
          LinkedIn
        </a>
      </li>
      <li>
        <a href={siteConfig.contact.github} target="_blank" rel="noopener noreferrer">
          GitHub
        </a>
      </li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid color-mix(in srgb, var(--color-bg) 15%, transparent);
    background-color: var(--color-text);
    color: var(--color-bg);
  }

  .site-footer__inner {
    padding-block: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .site-footer__copy {
    font-size: var(--text-sm);
    color: color-mix(in srgb, var(--color-bg) 65%, var(--color-text));
  }

  .site-footer__links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
  }

  .site-footer__links a {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    color: color-mix(in srgb, var(--color-bg) 65%, var(--color-text));
  }

  .site-footer__links a:hover {
    color: var(--color-primary);
  }
</style>
