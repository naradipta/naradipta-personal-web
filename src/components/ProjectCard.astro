---
interface Props {
  title: string;
  summary: string;
  role: string;
  status: "completed" | "in-progress";
  tags: string[];
  href: string;
  cover?: string;
}

const { title, summary, role, status, tags, href, cover } = Astro.props;
const statusLabel = status === "completed" ? "Completed" : "In Progress";
const initial = title.charAt(0).toUpperCase();
---

<article class="project-card">
  {
    cover ? (
      <a class="project-card__cover-link" href={href} tabindex="-1" aria-hidden="true">
        <img class="project-card__cover" src={cover} alt="" loading="lazy" />
      </a>
    ) : (
      <div class="project-card__cover project-card__cover--placeholder" aria-hidden="true">
        <span>{initial}</span>
      </div>
    )
  }
  <div class="project-card__body">
    <div class="project-card__header">
      <h3 class="project-card__title">
        <a href={href}>{title}</a>
      </h3>
      <span class:list={["badge", `badge--${status}`]}>{statusLabel}</span>
    </div>
    <p class="project-card__role">{role}</p>
    <p class="project-card__summary">{summary}</p>
    {
      tags.length > 0 && (
        <ul class="project-card__tags">
          {tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
    <p class="project-card__cta">
      Read More <span aria-hidden="true">→</span>
    </p>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: box-shadow 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .project-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary);
    transform: translateY(-4px);
  }

  .project-card__cover-link {
    display: block;
  }

  .project-card__cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .project-card__cover--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary-tint), var(--color-bg-subtle));
  }

  .project-card__cover--placeholder span {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    opacity: 0.5;
  }

  .project-card__body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .project-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .project-card__title {
    font-size: var(--text-lg);
  }

  .project-card__title a {
    text-decoration: none;
  }

  .project-card__title a:hover {
    color: var(--color-primary);
  }

  .project-card__title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .project-card__role {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-weight: var(--font-weight-medium);
  }

  .project-card__summary {
    color: var(--color-text-muted);
  }

  .project-card__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    padding: 0;
  }

  .project-card__tags li {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    background-color: var(--color-primary-tint);
    color: var(--color-primary);
  }

  .project-card__cta {
    margin-top: auto;
    padding-top: var(--space-4);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
  }

  .project-card__cta span {
    display: inline-block;
    transition: transform 0.15s ease;
  }

  .project-card:hover .project-card__cta span {
    transform: translateX(0.25rem);
  }
</style>
