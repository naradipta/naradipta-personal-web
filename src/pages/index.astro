---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import AboutSection from "../components/AboutSection.astro";
import ExperienceSection from "../components/ExperienceSection.astro";
import WhatIDoSection from "../components/WhatIDoSection.astro";
import SkillsGrid from "../components/SkillsGrid.astro";
import GallerySection from "../components/GallerySection.astro";
import ContactSection from "../components/ContactSection.astro";

const projects = await getCollection("projects");
const featuredProjects = projects
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <Hero />
  <AboutSection />

  <section class="projects" id="work">
    <div class="container">
      <p class="kicker">02 — Work</p>
      <div class="projects__header">
        <h2>What I've Built</h2>
        <a class="button button--ghost projects__see-all" href="/projects">
          See All Projects <span aria-hidden="true">→</span>
        </a>
      </div>
      {
        featuredProjects.length > 0 ? (
          <div class="projects__grid">
            {featuredProjects.map((project) => (
              <ProjectCard
                title={project.data.title}
                summary={project.data.summary}
                status={project.data.status}
                tags={project.data.tags}
                cover={project.data.cover}
                href={`/projects/${project.id}`}
              />
            ))}
          </div>
        ) : (
          <p class="projects__empty">Case studies coming soon.</p>
        )
      }
    </div>
  </section>

  <ExperienceSection />
  <WhatIDoSection />
  <SkillsGrid />
  <GallerySection />
  <ContactSection />
</BaseLayout>

<style>
  .projects {
    padding-block: var(--space-16);
  }

  .projects h2 {
    font-size: var(--text-2xl);
  }

  .projects__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .projects__header h2 {
    margin: 0;
  }

  .projects__grid {
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-6);
  }

  .projects__empty {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
  }

  .projects__see-all {
    flex-shrink: 0;
    gap: var(--space-2);
  }

  @media (max-width: 600px) {
    .projects__header h2 {
      font-size: var(--text-xl);
    }

    .projects__see-all {
      padding: var(--space-2) var(--space-4);
      font-size: var(--text-sm);
    }

    .projects__grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-block: var(--space-3) var(--space-2);
    }

    .projects__grid::-webkit-scrollbar {
      display: none;
    }

    .projects__grid :global(.project-card) {
      flex: 0 0 85%;
      scroll-snap-align: center;
    }
  }

  @media (max-width: 400px) {
    .projects {
      padding-block: var(--space-12);
    }

    .projects__grid :global(.project-card) {
      flex-basis: 90%;
    }
  }
</style>
