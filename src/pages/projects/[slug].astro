---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await render(project);
const statusLabel = project.data.status === "completed" ? "Completed" : "In Progress";
---

<BaseLayout title={`${project.data.title} — Muhammad Arrafi`} description={project.data.summary}>
  <article class="project-detail">
    <div class="container">
      <a class="project-detail__back" href="/#work">
        <span aria-hidden="true">←</span> Back to work
      </a>

      <header class="project-detail__header">
        <span class:list={["badge", `badge--${project.data.status}`]}>{statusLabel}</span>
        <h1>{project.data.title}</h1>
        <p class="project-detail__role">{project.data.role}</p>

        {
          project.data.tags.length > 0 && (
            <ul class="project-detail__tags">
              {project.data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }

        {
          (project.data.repo || project.data.demo) && (
            <div class="project-detail__links">
              {project.data.repo && (
                <a class="button button--ghost" href={project.data.repo} target="_blank" rel="noopener noreferrer">
                  GitHub Repo
                </a>
              )}
              {project.data.demo && (
                <a class="button button--ghost" href={project.data.demo} target="_blank" rel="noopener noreferrer">
                  Demo
                </a>
              )}
            </div>
          )
        }
      </header>

      {
        project.data.cover && (
          <img class="project-detail__cover" src={project.data.cover} alt="" loading="lazy" />
        )
      }

      <div class="project-detail__content">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .project-detail .container {
    padding-block: var(--space-12) var(--space-24);
    max-width: 48rem;
  }

  .project-detail__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s ease, gap 0.15s ease;
  }

  .project-detail__back:hover {
    color: var(--color-primary);
    gap: var(--space-3);
  }

  .project-detail__header {
    margin-top: var(--space-6);
  }

  .project-detail__header h1 {
    margin-top: var(--space-3);
    font-size: var(--text-3xl);
  }

  .project-detail__role {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .project-detail__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
  }

  .project-detail__tags li {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    background-color: var(--color-primary-tint);
    color: var(--color-primary);
  }

  .project-detail__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .project-detail__cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
    margin-top: var(--space-8);
  }

  .project-detail__content {
    margin-top: var(--space-8);
  }

  .project-detail__content :global(h2) {
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
    font-size: var(--text-xl);
  }

  .project-detail__content :global(h2:first-child) {
    margin-top: 0;
  }

  .project-detail__content :global(p) {
    margin-bottom: var(--space-4);
    color: var(--color-text-muted);
  }

  .project-detail__content :global(ul),
  .project-detail__content :global(ol) {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-6);
    color: var(--color-text-muted);
  }

  .project-detail__content :global(li) {
    margin-bottom: var(--space-2);
  }

  .project-detail__content :global(strong) {
    color: var(--color-text);
  }

  .project-detail__content :global(code) {
    font-family: var(--font-mono);
    background-color: var(--color-bg-subtle);
    padding: 0.15em 0.4em;
    border-radius: var(--radius-sm);
    font-size: 0.9em;
  }

  @media (max-width: 400px) {
    .project-detail .container {
      padding-block: var(--space-8) var(--space-16);
    }

    .project-detail__header h1 {
      font-size: var(--text-2xl);
    }
  }
</style>
