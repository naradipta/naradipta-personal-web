---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="All Projects — Muhammad Arrafi" description="Every case study and project by Muhammad Arrafi.">
  <section class="projects">
    <div class="container">
      <a class="projects__back" href="/#work">
        <span aria-hidden="true">←</span> Back to home
      </a>
      <p class="kicker">02 — Work</p>
      <h1>All Projects</h1>
      {
        projects.length > 0 ? (
          <div class="projects__grid">
            {projects.map((project) => (
              <ProjectCard
                title={project.data.title}
                summary={project.data.summary}
                status={project.data.status}
                tags={project.data.tags}
                cover={project.data.cover}
                href={`/projects/${project.id}`}
              />
            ))}
          </div>
        ) : (
          <p class="projects__empty">Case studies coming soon.</p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .projects .container {
    padding-block: var(--space-12) var(--space-24);
  }

  .projects__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s ease, gap 0.15s ease;
  }

  .projects__back:hover {
    color: var(--color-primary);
    gap: var(--space-3);
  }

  .projects h1 {
    margin-top: var(--space-3);
    font-size: var(--text-3xl);
  }

  .projects .kicker {
    margin-top: var(--space-6);
  }

  .projects__grid {
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-6);
  }

  .projects__empty {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
  }

  @media (max-width: 400px) {
    .projects h1 {
      font-size: var(--text-2xl);
    }
  }
</style>
