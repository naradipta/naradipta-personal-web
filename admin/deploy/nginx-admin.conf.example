# CONTOH konfigurasi Nginx untuk admin naradipta.com. Tidak dipasang otomatis oleh deploy.sh;
# salin dan sesuaikan secara manual (lihat admin/README.md).
#
# Di dalam blok `server` naradipta.com yang sudah ada, tambahkan:

    location = /admin { return 301 /admin/; }
    location /admin/ {
        proxy_pass http://127.0.0.1:4500/;      # slash di akhir: awalan /admin/ dibuang
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        client_max_body_size 12m;                # unggahan foto/PDF
        proxy_read_timeout 60s;
    }
