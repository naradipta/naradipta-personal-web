# CONTOH berkas env untuk container qa-drill. Salin ke `qa-drill.env` di folder yang sama dengan compose.yaml
# di server (mis. ~/apps/naradipta/qa-drill.env), `chmod 600`, lalu isi. JANGAN commit berkas aslinya.
# Tanpa berkas ini API tetap jalan, hanya fitur email (verifikasi, lupa password) yang mati.
# Daftar lengkap variabel: qa-drill/server/README.md

# Email (verifikasi dan lupa password). `smtp` = SMTP Brevo; `log` = isi email dicetak ke log container (untuk uji);
# `resend` = Resend HTTP API (butuh RESEND_API_KEY). Domain pengirim harus terautentikasi di penyedia.
MAIL_PROVIDER=smtp
MAIL_FROM=QA Drill <no-reply@naradipta.com>
# Brevo: SMTP & API -> SMTP -> Login (xxxx@smtp-brevo.com), lalu kunci SMTP (xsmtpsib-...; rahasia).
MAIL_SMTP_USER=
MAIL_SMTP_KEY=

# Alamat email admin yang boleh memakai nama yang dicadangkan, dipisah koma.
ADMIN_EMAILS=
