# CONTOH konfigurasi Nginx di HOST untuk mode Docker (compose.yaml). Menggantikan blok `naradipta.com`
# (/etc/nginx/sites-available/naradipta.com) dan `learn` (/etc/nginx/sites-available/learn) pada cutover.
# Sertifikat Let's Encrypt yang sudah ada tetap dipakai; jalur berkas sama dengan yang dibuat certbot.
#
# Nginx host hanya menghentikan TLS dan meneruskan SEMUA domain ke satu port (WEB_PORT, bawaan 8080).
# Pemisahan naradipta.com / /admin/ / learn.naradipta.com dilakukan container `web` (docker/nginx-web.conf).
# Header Host dan X-Real-IP wajib diteruskan: dipakai untuk memilih situs dan batas laju per IP.
#
# Cutover: cadangkan berkas lama, ganti isi, `sudo nginx -t && sudo systemctl reload nginx`.
# Rollback: kembalikan berkas lama lalu reload.

# --- naradipta.com (+ /admin/) ---
server {
    listen 80;
    listen [::]:80;
    server_name naradipta.com www.naradipta.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name naradipta.com www.naradipta.com;

    ssl_certificate     /etc/letsencrypt/live/naradipta.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/naradipta.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 12m;   # unggahan foto/PDF di /admin/

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;   # Publish menjalankan astro build
    }
}

# --- learn.naradipta.com (QA Drill: statis + /api/) ---
server {
    listen 80;
    listen [::]:80;
    server_name learn.naradipta.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name learn.naradipta.com;

    ssl_certificate     /etc/letsencrypt/live/learn.naradipta.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/learn.naradipta.com/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 1500k;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
