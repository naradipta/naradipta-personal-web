# CONTOH unit systemd: /etc/systemd/system/qa-drill.service (pasang manual, lalu: systemctl enable --now qa-drill)
[Unit]
Description=QA Drill API (login + sinkronisasi)
After=network.target

[Service]
User=www-data
WorkingDirectory=/var/www/naradipta-personal-web/qa-drill/server
Environment=NODE_ENV=production
Environment=PORT=4400
Environment=HOST=127.0.0.1
Environment=TRUST_PROXY=1
Environment=ALLOWED_ORIGIN=https://learn.naradipta.com
Environment=DB_PATH=/var/lib/qa-drill/qa-drill.sqlite
ExecStart=/usr/bin/node server.js
Restart=on-failure
# Hardening dasar
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/qa-drill
PrivateTmp=true

[Install]
WantedBy=multi-user.target
